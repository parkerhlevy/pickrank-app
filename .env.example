# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for internal validation scripts and any trusted server-only writes after RLS is enabled.
SUPABASE_SERVICE_ROLE_KEY=

# Resend waitlist email and contact sync. Keep these server-only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=PickRank <hello@pickrankgames.com>
RESEND_REPLY_TO_EMAIL=
RESEND_WAITLIST_SEGMENT_ID=
# Optional. Enable only after the Resend waitlist welcome Automation is enabled and tested.
RESEND_WAITLIST_WELCOME_EVENT_NAME=

# App
# Production auth callbacks use this value. Vercel preview auth callbacks use trusted VERCEL_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public experience mode. Production is forced to early_access_beta in code.
# Use paid_preview only for local or Vercel Preview UI work.
PICKRANK_EXPERIENCE_MODE=early_access_beta
# Server-only comma-separated emails reviewable for controlled internal testing only; this does not authorize paid entry.
PICKRANK_INTERNAL_TEST_ACCOUNT_EMAILS=
# Internal read-only provider evaluation only. Do not expose this key to the browser.
PICKRANK_MYSPORTSFEEDS_API_KEY=
PICKRANK_MYSPORTSFEEDS_PASSWORD=MYSPORTSFEEDS
PICKRANK_MYSPORTSFEEDS_BASE_URL=https://api.mysportsfeeds.com/v2.1/pull/nfl
PICKRANK_MYSPORTSFEEDS_SEASON=2026-regular
PICKRANK_MYSPORTSFEEDS_WEEK=1
PICKRANK_MYSPORTSFEEDS_ACCESS_LEVEL=live_10min_delay

# Supabase dashboard configuration still required:
# - Google provider credentials in Authentication -> Providers -> Google
# - Custom SMTP for production email fallback in Authentication -> Emails -> SMTP Settings
