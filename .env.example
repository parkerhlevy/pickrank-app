# Supabase
# Use the same values locally in `.env.local` and in Vercel Project Settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
# Local dev should stay `http://localhost:3000`.
# In Vercel, set this to the deployment URL that should receive auth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
